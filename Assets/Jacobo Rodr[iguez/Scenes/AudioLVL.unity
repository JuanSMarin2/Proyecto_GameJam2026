  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  dialogues:
  - "Asi que tu eres el que ha estado robando mis m\xE1scaras no es asi?"
  - "La gente que rompe el equilibrio de las m\xE1scaras no se sale con la suya tan
    f\xE1cil"
  - "Soy la bruja maligna de las m\xE1scaras y est\xE1s en mi Guarida!"
  - "Tendr\xE1s que pasar por encima de mi si quieres salir de este templo."
